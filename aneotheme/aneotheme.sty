\ProvidesPackage{aneotheme}

% --- Package options ---
% blue: blue header/footer  |  white (default): gray header/footer
% dark: dark background     |  light (default): light gray background
\newif\if@aneoBlue
\@aneoBluefalse

\newif\if@aneoDark
\@aneoDarkfalse

\newif\if@aneoArmoniK
\@aneoArmoniKfalse

\DeclareOption{blue}{\@aneoBluetrue}
\DeclareOption{white}{\@aneoBluefalse}
\DeclareOption{dark}{\@aneoDarktrue}
\DeclareOption{light}{\@aneoDarkfalse}
\DeclareOption{armonik}{\@aneoArmoniKtrue}
\DeclareOption{noarmonik}{\@aneoArmoniKfalse}
\ProcessOptions\relax

\usetheme{default}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{graphicx}
% Generic command: converts basename.svg to basename.pdf on first use, then includes it
\newcommand{\aneoincludesvg}[2][]{%
  \directlua{
    local svgfile = kpse.find_file('#2.svg', 'tex')
    if svgfile then
      local dir = svgfile:match('(.*[/])')
      local pdffile = dir .. '#2.pdf'
      local f = io.open(pdffile, 'r')
      if f then f:close() else
        os.execute('inkscape "' .. svgfile .. '" --export-filename="' .. pdffile .. '"')
      end
    end
  }%
  \includegraphics[#1]{#2.pdf}%
}
\RequirePackage{poppinsfonts}

% Set titles and subtitles in Poppins Semibold as
% in the charte graphique from 2024
\setbeamerfont{frametitle}{family=\poppinsboldfont}
\setbeamerfont{title}{family=\poppinsboldfont}
\setbeamerfont{section title}{family=\poppinsboldfont}
\setbeamerfont{subtitle}{family=\poppinsboldfont}


\AtBeginDocument{
  \institute{{\poppinsboldfont ANEO}}
}

% Define primary colors
\definecolor{aneoorange}{RGB}{254, 81, 0}
\definecolor{aneoblue}{RGB}{0, 15, 159}
\definecolor{aneoblack}{RGB}{20, 20, 20}

% Define secondary colors
\definecolor{aneoyellow}{RGB}{255, 182, 0}
\definecolor{aneoturquoise}{RGB}{0, 196, 176}
\definecolor{aneogray}{RGB}{238, 239, 240}

% Color theme in structure
\usecolortheme[named=aneoblue]{structure}

% Customize inner elements
\setbeamercolor{title}{fg=aneoblack,bg=aneoorange}

% Color of items/numbers in lists
\setbeamercolor{item}{fg=aneoorange}
\setbeamertemplate{itemize item}{$\bullet$}
\setbeamertemplate{itemize subitem}{$\bullet$}
\setbeamertemplate{itemize subsubitem}{$\bullet$}

% Color of the outline section
\setbeamercolor{section in toc}{fg=aneoblue}

% Background canvas
\if@aneoDark
  \setbeamercolor{background canvas}{bg=aneoblack}
  \setbeamercolor{normal text}{fg=aneogray,bg=aneoblack}
\else
  \setbeamercolor{background canvas}{bg=aneogray}
\fi

% Block colors
\setbeamerfont{block title}{family=\poppinsboldfont}
\setbeamercolor{block title}{bg=aneoturquoise,fg=aneoblack}
\setbeamercolor{block body}{bg=aneoturquoise!20,fg=aneoblack}

\setbeamerfont{block title alerted}{family=\poppinsboldfont}
\setbeamercolor{block title alerted}{bg=aneoorange,fg=aneoblack}
\setbeamercolor{block body alerted}{bg=aneoorange!20,fg=aneoblack}

\setbeamerfont{block title example}{family=\poppinsboldfont}
\setbeamercolor{block title example}{bg=aneoblue,fg=white}
\setbeamercolor{block body example}{bg=aneoblue!20,fg=aneoblack}

% Navigation symbols off
\setbeamertemplate{navigation symbols}{}


% Define the title page emulating ppt aneo template
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[overlay, remember picture]
    % Orange top bar
    \fill[aneoorange] (current page.north west) rectangle ([yshift=-0.1\paperheight]current page.north east);
    % Blue bottom bar
    \fill[aneoblue] (current page.south west) rectangle ([yshift=0.08\paperheight]current page.south east);
    % Title
    \node[anchor=center, align=center, text width=0.82\paperwidth]
      at ([yshift=0.14\paperheight]current page.center){%
        {\usebeamerfont{title}\LARGE\color{aneoblue}\inserttitle}%
    };
    % Subtitle
    \node[anchor=center, align=center, text width=0.82\paperwidth]
      at ([yshift=0.06\paperheight]current page.center){%
        {\usebeamerfont{subtitle}\large\color{aneoblack}\insertsubtitle}%
    };
    % Author and date
    \node[anchor=center, align=center, text width=0.82\paperwidth]
      at ([yshift=-0.03\paperheight]current page.center){%
        {\usebeamerfont{author}\normalsize\color{aneoblack}\insertauthor}%
        \quad\textbullet\quad%
        {\usebeamerfont{date}\normalsize\color{aneoblack}\insertdate}%
    };
    % Aneo and ArmoniK logos side by side
    \node[anchor=center]
      at ([yshift=-0.2\paperheight]current page.center){%
        \includegraphics[height=1.3cm]{LOGO_COULEUR_1.png}%
        \if@aneoArmoniK
          \hspace{4em}%
          \aneoincludesvg[height=1.3cm]{logo-ak}%
        \fi
    };
  \end{tikzpicture}
}
\renewcommand{\titlepage}{
  \begin{frame}[plain,noframenumbering]
    \usebeamertemplate{title page}
  \end{frame}
}

% Define the closing page emulating ppt aneo template
\newcommand{\closingpage}{
  \begin{frame}[plain, noframenumbering]
  \begin{tikzpicture}[remember picture,overlay]
    \fill[aneoorange] (current page.south west) rectangle (current page.north east);
    \node[anchor=south east] at ([yshift=-0.25\paperheight, xshift=0.2\paperwidth]current page.center){%
      \includegraphics[width=3cm,height=3cm,keepaspectratio]{LOGO_BLANC.png}
    };
    \node[anchor=north,align=left] at ([yshift=-0.25\paperheight, xshift=0.2\paperwidth]current page.center){%
      \begin{minipage}{0.35\paperwidth}
        \footnotesize
        \color{aneogray}
        122 avenue du general Leclerc \\[1ex]
        91200 Boulogne-Billancourt \\[1ex]
        www.aneo.eu
      \end{minipage}
    };
  \end{tikzpicture}%
  \end{frame}
}

% Custom footline with [short] title, [short] author and slide number
\setbeamertemplate{footline}{}
\if@aneoBlue
  \setbeamercolor{author in head/foot}{bg=aneoblue, fg=aneogray}
  \setbeamercolor{title in head/foot}{bg=aneoblue, fg=aneogray}
\else
  \if@aneoDark
    \setbeamercolor{author in head/foot}{bg=aneoblack, fg=aneogray}
    \setbeamercolor{title in head/foot}{bg=aneoblack, fg=aneogray}
  \else
    \setbeamercolor{author in head/foot}{bg=aneogray, fg=aneoblack}
    \setbeamercolor{title in head/foot}{bg=aneogray, fg=aneoblack}
  \fi
\fi
\setbeamertemplate{footline}{%
  \ifnum\value{framenumber}>0%
    \leavevmode%
    \hbox to \paperwidth{%
      % Author
      \begin{beamercolorbox}[wd=0.45\paperwidth,ht=2.5ex,dp=1ex,left]{author in head/foot}%
        \usebeamerfont{author in head/foot}\hspace{1em}\insertshortauthor
      \end{beamercolorbox}%
      % Title
      \begin{beamercolorbox}[wd=0.4\paperwidth,ht=2.5ex,dp=1ex,left]{title in head/foot}%
        \usebeamerfont{title in head/foot}\insertshorttitle
      \end{beamercolorbox}%
      \kern-0.5pt%
      % Slide number — 0.5pt overlap with title box closes PDF anti-aliasing seam;
      % width adjusted so total remains exactly \paperwidth
      \begin{beamercolorbox}[wd=\dimexpr\paperwidth-0.45\paperwidth-0.4\paperwidth+0.5pt\relax,ht=2.5ex,dp=1ex,right]{title in head/foot}%
        \usebeamerfont{title in head/foot}\insertframenumber{}\hspace{1em}
      \end{beamercolorbox}%
  }%
  \fi
  \vskip0pt%
}

% Custom headline with current slide title left and aneo logo to the right
\setbeamertemplate{headline}{}
\if@aneoBlue
  \setbeamercolor{frametitle}{fg=white,bg=aneoblue}
  \def\aneothemelogofile{LogoA_blanc.png}
\else
  \if@aneoDark
    \setbeamercolor{frametitle}{fg=aneoorange,bg=aneoblack}
  \else
    \setbeamercolor{frametitle}{fg=aneoorange,bg=aneogray}
  \fi
  \def\aneothemelogofile{LogoA_couleur.png}
\fi
\newcommand{\safeinsertframetitle}{%
  \@ifundefined{insertframetitle}{}{%
    \insertframetitle%
  }%
}
\setbeamertemplate{headline}{%
  \ifnum\value{framenumber}>0
    \leavevmode
    \hbox to \paperwidth{%
      % Left box: slide title, empty if not defined
      \begin{beamercolorbox}[wd=0.85\paperwidth,ht=3em,dp=2ex,leftskip=1em]{frametitle}%
        \usebeamerfont{frametitle}\safeinsertframetitle
      \end{beamercolorbox}%
      \kern-0.5pt%
      % Right box: aneo logo — 0.5pt overlap closes PDF anti-aliasing seam;
      % width adjusted so total remains exactly \paperwidth
      \begin{beamercolorbox}[wd=\dimexpr\paperwidth-0.85\paperwidth+0.5pt\relax,ht=3em,dp=2ex,rightskip=1em]{frametitle}%
        \hfill\includegraphics[height=2.5em]{\aneothemelogofile}%
      \end{beamercolorbox}%
    }%
  \fi
  \vskip0pt
}
\setbeamertemplate{frametitle}{}
